# ==============================================================================
# ClaudeCodeCoin - Secrets Configuration
# ==============================================================================
#
# IMPORTANT:
# 1. Copy this file to secrets.env
# 2. Fill in your actual credentials
# 3. NEVER commit secrets.env to version control (it's in .gitignore)
#
# ==============================================================================

# Environment
ENVIRONMENT=development

# Database Credentials
DATABASE_PASSWORD=ccc_password_change_in_production
DATABASE_URL=postgresql://ccc_user:ccc_password_change_in_production@localhost:5432/ccc_trading

# Redis Credentials
REDIS_PASSWORD=ccc_redis_password_change_in_production

# Exchange API Keys - Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true

# Exchange API Keys - Bybit
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here
BYBIT_TESTNET=true

# Exchange API Keys - Coinbase
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET_KEY=your_coinbase_secret_key_here

# Exchange API Keys - Gate.io
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET_KEY=your_gateio_secret_key_here
GATEIO_TESTNET=false

# Twitter API (for sentiment analysis)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Reddit API (for sentiment analysis)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ClaudeCodeCoin/1.0

# On-Chain Data Providers
GLASSNODE_API_KEY=your_glassnode_api_key_here
CRYPTOQUANT_API_KEY=your_cryptoquant_api_key_here

# Blockchain RPC Endpoints (if using direct blockchain access)
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
BITCOIN_RPC_URL=your_bitcoin_rpc_url_here

# Google Cloud (if using GCP services)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCP_PROJECT_ID=your_gcp_project_id

# AWS (if using AWS services)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Monitoring & Alerting
GRAFANA_API_KEY=your_grafana_api_key_here
PAGERDUTY_API_KEY=your_pagerduty_api_key_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Security
JWT_SECRET_KEY=your_jwt_secret_key_for_internal_apis
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# Rate Limiting & API Management
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=DEBUG
