# ClaudeCodeCoin - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# GATE.IO API CREDENTIALS
# ============================================================================
# Get your API keys from: https://www.gate.io/myaccount/apiv4keys
# IMPORTANT: Enable "Futures Trading" permission ONLY
# NEVER enable "Withdrawal" permission!

GATEIO_API_KEY=your_api_key_here
GATEIO_API_SECRET=your_api_secret_here

# ============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# ============================================================================
# Create bot: https://t.me/BotFather
# Get chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# TRADING CONFIGURATION (Optional - defaults in config_futures.py)
# ============================================================================

# Initial balance (default: 1000.0)
# INITIAL_BALANCE=1000.0

# Max leverage (default: 3)
# MAX_LEVERAGE=3

# Position size in USD (default: 100.0)
# POSITION_SIZE_USD=100.0

# Max open positions (default: 10)
# MAX_OPEN_POSITIONS=10

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env file to git (it's in .gitignore)
# 2. Use IP whitelist in Gate.io API settings
# 3. Start with testnet first
# 4. Enable only required permissions (Futures Trading)
# 5. Use strong, unique API secrets
# 6. Rotate API keys regularly
# 7. Monitor API usage logs

# ============================================================================
# TESTNET vs MAINNET
# ============================================================================
# Testnet: https://fx-test.gateio.pro/
# - Free test USDT
# - No real money risk
# - Perfect for testing

# Mainnet: https://www.gate.io/
# - Real money!
# - Start with small amounts
# - Only after thorough testing

# To use testnet:
# python futures_trading_engine.py --testnet

# To use mainnet (REAL MONEY):
# python futures_trading_engine.py --real --mainnet
